            "title": "per call: a loopback literal",
            "since": "0.1.27",
            "notes": "Hostile: the caller chose this address for one call, and it must be refused before any request. The plainest form of the refusal.",
            "given": {
                "kind": "per-call",
                "provider": "openai",
                "env": {},
                "config": {
                    "url": "http://127.0.0.1:8000/v1"
                }
            },
            "result": {
                "php": {
                    "dispatched": false,
                    "refusal": "private_address_refused"
                },
                "ts": {
                    "dispatched": false,
                    "refusal": "private_address_refused"
                },
