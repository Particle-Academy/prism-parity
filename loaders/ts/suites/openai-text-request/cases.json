            }
        },
        {
            "id": "trq-0018",
            "title": "assistant message carrying tool calls",
            "since": "0.1.0",
            "notes": "A tool call expands to its own top-level item, not a field on the assistant message, and its arguments are re-encoded as a JSON STRING rather than an object. Pins the double encoding, which is easy to miss and produces a request OpenAI accepts but misreads.",
            "builder": [
                {
                    "call": "using",
                    "args": [
                        "openai",
                        "gpt-4o"
                    ]
                },
                {
                    "call": "withMessages",
                    "args": [
                        [
                            {
                                "$": "UserMessage",
                                "content": "Weather in Paris?"
                            },
                            {
                                "$": "AssistantMessage",
                                "content": "",
                                "toolCalls": [
                                    {
                                        "$": "ToolCall",
                                        "id": "fc_1",
                                        "name": "weather",
                                        "arguments": {
                                            "city": "Paris"
                                        },
                                        "resultId": "call_1"
                                    }
                                ]
                            }
                        ]
                    ]
                }
            ],
            "expect": {
                "body_json": "{\"model\":\"gpt-4o\",\"input\":[{\"role\":\"user\",\"content\":[{\"type\":\"input_text\",\"text\":\"Weather in Paris?\"}]},{\"id\":\"fc_1\",\"call_id\":\"call_1\",\"type\":\"function_call\",\"name\":\"weather\",\"arguments\":\"{\\\"city\\\":\\\"Paris\\\"}\"}],\"max_output_tokens\":null}"
            }
        },
