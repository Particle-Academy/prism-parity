            }
        },
        {
            "id": "trq-0008",
            "title": "withTools with an empty list omits the tools key entirely",
            "since": "0.1.0",
            "notes": "The reference collapses an empty tool list to null and the not-null filter then drops the key. An empty array is falsy in PHP and TRUTHY in JavaScript and Python, so a direct port sends an empty tools array — which OpenAI rejects on some models and which silently changes tool_choice defaults on others. This row is the one that DECLARES an empty tool list, which is why it exists — it documents the intent. It is not the only row that catches the hazard: every request that never calls withTools has an empty tool list too, so 20 of the 28 rows here go red under the keep-empty-tools probe. Said plainly because the earlier wording called this the highest-value falsiness trap in the suite, and measurement showed 19 other rows catch the same thing. The correction came from BOTH ports reaching the 20-row conclusion independently, one of them before the ruling arrived — two implementations separately disagreeing with a declaration is the strongest available signal that the corpus was wrong rather than either port being confused.",
            "builder": [
                {
                    "call": "using",
                    "args": [
                        "openai",
                        "gpt-4o"
                    ]
                },
                {
                    "call": "withPrompt",
                    "args": [
                        "hi"
                    ]
                },
                {
                    "call": "withTools",
                    "args": [
                        []
                    ]
                }
            ],
            "expect": {
                "body_json": "{\"model\":\"gpt-4o\",\"input\":[{\"role\":\"user\",\"content\":[{\"type\":\"input_text\",\"text\":\"hi\"}]}],\"max_output_tokens\":null}"
            }
        },
        {
            "id": "trq-0009",
            "title": "one tool with a required string parameter",
            "since": "0.1.0",
            "notes": "Pins the JSON Schema fragment the reference builds, including the property key order (description before type) which is decided by the schema value object rather than by the tool mapper.",
            "builder": [
                {
                    "call": "using",
                    "args": [
                        "openai",
                        "gpt-4o"
                    ]
                },
                {
                    "call": "withPrompt",
                    "args": [
                        "hi"
                    ]
                },
                {
                    "call": "withTools",
                    "args": [
                        [
                            {
                                "$": "Tool",
                                "as": "weather",
                                "for": "Get the weather",
                                "parameters": [
                                    {
                                        "type": "string",
                                        "name": "city",
                                        "description": "The city",
                                        "required": true
                                    }
                                ]
                            }
                        ]
                    ]
                }
            ],
            "expect": {
                "body_json": "{\"model\":\"gpt-4o\",\"input\":[{\"role\":\"user\",\"content\":[{\"type\":\"input_text\",\"text\":\"hi\"}]}],\"max_output_tokens\":null,\"tools\":[{\"type\":\"function\",\"name\":\"weather\",\"description\":\"Get the weather\",\"parameters\":{\"type\":\"object\",\"properties\":{\"city\":{\"description\":\"The city\",\"type\":\"string\"}},\"required\":[\"city\"]}}]}"
            }
        },
