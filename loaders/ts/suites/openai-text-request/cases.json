{
    "suite": "openai-text-request",
    "cases": [
        {
            "id": "trq-0001",
            "title": "prompt only",
            "since": "0.1.0",
            "notes": "The baseline, and the single most important row in the corpus: max_output_tokens is emitted as an explicit null even though it was never set, because the reference merges it OUTSIDE the not-null filter. A port that models 'unset' as undefined drops the key and the bytes differ. This is the absent-vs-null hazard in its smallest form.",
            "builder": [
                {
                    "call": "using",
                    "args": [
                        "openai",
                        "gpt-4o"
                    ]
                },
                {
                    "call": "withPrompt",
                    "args": [
                        "Who are you?"
                    ]
                }
            ],
            "expect": {
                "body_json": "{\"model\":\"gpt-4o\",\"input\":[{\"role\":\"user\",\"content\":[{\"type\":\"input_text\",\"text\":\"Who are you?\"}]}],\"max_output_tokens\":null}"
            }
        },
        {
            "id": "trq-0002",
            "title": "system prompt precedes the prompt",
            "since": "0.1.0",
            "notes": "System prompts are prepended to the message list rather than carried in a separate field. Pins the ordering, and pins that a system message maps to a bare string content while a user message maps to a parts array — the two roles are shaped differently in the same payload.",
            "builder": [
                {
                    "call": "using",
                    "args": [
                        "openai",
                        "gpt-4o"
                    ]
                },
                {
                    "call": "withSystemPrompt",
                    "args": [
                        "You are terse."
                    ]
                },
                {
                    "call": "withPrompt",
                    "args": [
                        "Who are you?"
                    ]
                }
            ],
            "expect": {
                "body_json": "{\"model\":\"gpt-4o\",\"input\":[{\"role\":\"system\",\"content\":\"You are terse.\"},{\"role\":\"user\",\"content\":[{\"type\":\"input_text\",\"text\":\"Who are you?\"}]}],\"max_output_tokens\":null}"
            }
        },
        {
            "id": "trq-0003",
            "title": "two system prompts accumulate in call order",
            "since": "0.1.0",
            "notes": "withSystemPrompt appends rather than replaces. A port that models it as a setter passes trq-0002 and fails here, which is why one system-prompt case is not enough.",
            "builder": [
                {
                    "call": "using",
                    "args": [
                        "openai",
                        "gpt-4o"
                    ]
                },
                {
                    "call": "withSystemPrompt",
                    "args": [
                        "A"
                    ]
                },
                {
                    "call": "withSystemPrompt",
                    "args": [
                        "B"
                    ]
                },
                {
                    "call": "withPrompt",
                    "args": [
                        "hi"
                    ]
                }
            ],
            "expect": {
                "body_json": "{\"model\":\"gpt-4o\",\"input\":[{\"role\":\"system\",\"content\":\"A\"},{\"role\":\"system\",\"content\":\"B\"},{\"role\":\"user\",\"content\":[{\"type\":\"input_text\",\"text\":\"hi\"}]}],\"max_output_tokens\":null}"
            }
        },
        {
            "id": "trq-0004",
            "title": "max tokens set",
            "since": "0.1.0",
            "notes": "The value half of trq-0001: when max_output_tokens IS set it carries the integer. Together the two rows pin that the key is unconditional and only its value varies.",
