                    ]
                }
            ],
            "expect": {
                "body_json": "{\"model\":\"gpt-4o\",\"input\":[{\"role\":\"user\",\"content\":[{\"type\":\"input_text\",\"text\":\"hi\"}]}],\"max_output_tokens\":null,\"tools\":[{\"type\":\"function\",\"name\":\"ping\",\"description\":\"Ping\"}]}"
            }
        },
