            }
        },
        {
            "id": "trq-0005",
            "title": "temperature 0.7",
            "since": "0.1.0",
            "notes": "A non-integral float, which every language renders identically. Paired deliberately with trq-0025, which uses an integral float and does not.",
            "builder": [
                {
                    "call": "using",
