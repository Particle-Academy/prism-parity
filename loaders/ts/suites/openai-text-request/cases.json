        {
            "id": "trq-0025",
            "title": "integral float temperature",
            "since": "0.1.0",
            "notes": "A genuine language divergence, kept rather than avoided. PHP and JavaScript render the float 1.0 as 1; Python's json module renders it as 1.0. Both are the same JSON number and neither is wrong, but the bytes differ. trq-0005 pins the same rule in the form every language agrees on.",
            "builder": [
                {
                    "call": "using",
                    "args": [
                        "openai",
                        "gpt-4o"
                    ]
                },
                {
                    "call": "withPrompt",
                    "args": [
                        "hi"
                    ]
                },
                {
                    "call": "usingTemperature",
                    "args": [
                        1
                    ]
                }
            ],
            "expect": {
                "body_json": "{\"model\":\"gpt-4o\",\"input\":[{\"role\":\"user\",\"content\":[{\"type\":\"input_text\",\"text\":\"hi\"}]}],\"max_output_tokens\":null,\"temperature\":1}"
            },
            "skip": {
                "py": "Python's json module renders the float 1.0 as 1.0 where PHP and JavaScript render 1. Same JSON number, different bytes, and no side is wrong. prism-py normalises integral floats in its canonical encoder so the wire bytes do match — the row is skipped anyway so the divergence stays visible in the corpus instead of being hidden inside one port's encoder. See docs/decisions/0005-canonical-json.md."
            }
        },
