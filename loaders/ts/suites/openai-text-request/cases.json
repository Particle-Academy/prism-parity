                "body_json": "{\"model\":\"gpt-4o\",\"input\":[{\"role\":\"user\",\"content\":[{\"type\":\"input_text\",\"text\":\"hi\"}]}],\"max_output_tokens\":null,\"temperature\":0.7}"
            }
        },
        {
            "id": "trq-0006",
            "title": "temperature 0 survives the not-null filter",
            "since": "0.1.0",
            "notes": "Zero is falsy in PHP and in JavaScript. The reference filters this key on null, not on falsiness, so temperature 0 is sent. A port that reaches for a truthiness check drops a deliberate deterministic-sampling setting and the model silently samples at its default.",
            "builder": [
                {
                    "call": "using",
                    "args": [
                        "openai",
                        "gpt-4o"
                    ]
                },
                {
                    "call": "withPrompt",
                    "args": [
                        "hi"
                    ]
                },
                {
                    "call": "usingTemperature",
                    "args": [
                        0
                    ]
                }
            ],
            "expect": {
                "body_json": "{\"model\":\"gpt-4o\",\"input\":[{\"role\":\"user\",\"content\":[{\"type\":\"input_text\",\"text\":\"hi\"}]}],\"max_output_tokens\":null,\"temperature\":0}"
            }
        },
