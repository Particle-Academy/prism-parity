        {
            "id": "cs-0016",
            "title": "a padded url with edge spaces is refused",
            "since": "0.1.25",
            "notes": "Padded: leading and trailing spaces around the trusted url. A url carrying whitespace or a control character anywhere is refused before any request in all three languages, never trimmed: PHP's verdict on a padded url used to depend on its HTTP stack (refused before dispatch under Guzzle 8, sent to the trusted host with the inherited key under Guzzle 7), while TypeScript and Python trimmed it and sent the key. Refusal is the one answer that does not move with a library.",
            "given": {
                "kind": "endpoint",
                "provider": "openai",
                "env": {
                    "OPENAI_API_KEY": "sk-test-fixture"
                },
                "config": {
                    "url": " https://api.openai.com/v1 "
                }
            },
            "result": {
                "php": {
                    "dispatched": false,
                    "credential": "none",
                    "account": "none"
                },
                "ts": {
                    "dispatched": false,
                    "credential": "none",
                    "account": "none"
