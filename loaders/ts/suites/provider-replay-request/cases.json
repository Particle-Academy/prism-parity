{
    "suite": "provider-replay-request",
    "cases": [
        {
            "id": "rpl-0001",
            "title": "OpenAI ordered opaque reasoning and message replay",
            "since": "0.1.10",
            "notes": "Metadata replaces legacy text without duplicate assistant items. Opaque encrypted content remains byte-identical.",
            "builder": [
                {
                    "call": "using",
                    "args": [
                        "openai",
                        "gpt-4o"
                    ]
                },
                {
                    "call": "withMaxTokens",
                    "args": [
                        64
                    ]
                },
                {
                    "call": "withMessages",
                    "args": [
                        [
                            {
                                "$": "UserMessage",
                                "content": "Owned replay fixture"
                            },
                            {
                                "$": "AssistantMessage",
                                "content": "Legacy fallback must not duplicate replay",
                                "additionalContent": {
                                    "output_items": [
                                        {
                                            "id": "rs_owned_replay",
                                            "type": "reasoning",
                                            "summary": [],
                                            "encrypted_content": "synthetic-owned-encrypted-β+/="
                                        },
                                        {
                                            "id": "msg_owned_replay",
                                            "type": "message",
                                            "role": "assistant",
                                            "status": "completed",
                                            "content": [
                                                {
                                                    "type": "output_text",
                                                    "text": "Owned answer",
                                                    "annotations": []
                                                }
                                            ]
                                        }
                                    ]
                                }
                            }
                        ]
                    ]
                }
            ],
            "expect": {
                "body_json": "{\"model\":\"gpt-4o\",\"input\":[{\"role\":\"user\",\"content\":[{\"type\":\"input_text\",\"text\":\"Owned replay fixture\"}]},{\"id\":\"rs_owned_replay\",\"type\":\"reasoning\",\"summary\":[],\"encrypted_content\":\"synthetic-owned-encrypted-β+/=\"},{\"id\":\"msg_owned_replay\",\"type\":\"message\",\"role\":\"assistant\",\"status\":\"completed\",\"content\":[{\"type\":\"output_text\",\"text\":\"Owned answer\",\"annotations\":[]}]}],\"max_output_tokens\":64}"
            }
        },
