        {
            "id": "rpl-0007",
            "title": "Anthropic fallback echo drops superseded signed content",
            "since": "0.1.10",
            "notes": "Reference fallback projection retains text/fallback and serving blocks, removing superseded thinking without reordering opaque surviving content.",
            "builder": [
                {
                    "call": "using",
                    "args": [
                        "anthropic",
                        "claude-sonnet-4-5"
                    ]
                },
                {
                    "call": "withMaxTokens",
                    "args": [
                        64
                    ]
                },
                {
                    "call": "withMessages",
                    "args": [
                        [
                            {
                                "$": "UserMessage",
                                "content": "Owned replay fixture"
                            },
                            {
                                "$": "AssistantMessage",
                                "content": "Legacy fallback must not duplicate replay",
                                "additionalContent": {
                                    "content_blocks": [
                                        {
                                            "type": "thinking",
                                            "thinking": "Owned thought",
                                            "signature": "synthetic-owned-opaque-α+/="
                                        },
                                        {
                                            "type": "connector_text",
                                            "text": "superseded"
                                        },
                                        {
                                            "type": "text",
                                            "text": "Kept prior text"
                                        },
                                        {
                                            "type": "fallback",
                                            "from": {
                                                "model": "owned-a"
                                            },
                                            "to": {
                                                "model": "owned-b"
                                            }
                                        },
                                        {
                                            "type": "redacted_thinking",
                                            "data": "synthetic-owned-redacted-+/="
                                        },
                                        {
                                            "type": "text",
                                            "text": "Serving answer"
                                        }
                                    ]
                                }
                            }
                        ]
                    ]
                }
            ],
            "expect": {
                "body_json": "{\"model\":\"claude-sonnet-4-5\",\"messages\":[{\"role\":\"user\",\"content\":[{\"type\":\"text\",\"text\":\"Owned replay fixture\"}]},{\"role\":\"assistant\",\"content\":[{\"type\":\"text\",\"text\":\"Kept prior text\"},{\"type\":\"fallback\",\"from\":{\"model\":\"owned-a\"},\"to\":{\"model\":\"owned-b\"}},{\"type\":\"redacted_thinking\",\"data\":\"synthetic-owned-redacted-+/=\"},{\"type\":\"text\",\"text\":\"Serving answer\"}]}],\"max_tokens\":64}"
            }
        },
