        {
            "id": "rpl-0004",
            "title": "Anthropic ordered content blocks override legacy metadata",
            "since": "0.1.10",
            "notes": "Verbatim ordered thinking/signature, redacted and text blocks override convenience text/thinking. No concatenation or duplicated fallback.",
            "builder": [
                {
                    "call": "using",
                    "args": [
                        "anthropic",
                        "claude-sonnet-4-5"
                    ]
                },
                {
                    "call": "withMaxTokens",
                    "args": [
                        64
                    ]
                },
                {
                    "call": "withMessages",
                    "args": [
                        [
                            {
                                "$": "UserMessage",
                                "content": "Owned replay fixture"
                            },
                            {
                                "$": "AssistantMessage",
                                "content": "Legacy fallback must not duplicate replay",
                                "additionalContent": {
                                    "content_blocks": [
                                        {
                                            "type": "thinking",
                                            "thinking": "Owned thought",
                                            "signature": "synthetic-owned-opaque-α+/="
                                        },
                                        {
                                            "type": "text",
                                            "text": "First text"
                                        },
                                        {
                                            "type": "redacted_thinking",
                                            "data": "synthetic-owned-redacted-+/="
                                        },
                                        {
                                            "type": "text",
                                            "text": "Second text"
                                        }
                                    ],
                                    "thinking": "legacy ignored",
                                    "thinking_signature": "synthetic-legacy-ignored"
                                }
                            }
                        ]
                    ]
                }
            ],
            "expect": {
                "body_json": "{\"model\":\"claude-sonnet-4-5\",\"messages\":[{\"role\":\"user\",\"content\":[{\"type\":\"text\",\"text\":\"Owned replay fixture\"}]},{\"role\":\"assistant\",\"content\":[{\"type\":\"thinking\",\"thinking\":\"Owned thought\",\"signature\":\"synthetic-owned-opaque-α+/=\"},{\"type\":\"text\",\"text\":\"First text\"},{\"type\":\"redacted_thinking\",\"data\":\"synthetic-owned-redacted-+/=\"},{\"type\":\"text\",\"text\":\"Second text\"}]}],\"max_tokens\":64}"
            }
        },
