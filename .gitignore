!/package-lock.json

# Composer mirrors the path package into vendor/; `composer update` has been
# observed reporting success while silently keeping the old bytes, so the mirror
# is never a source of truth. Delete it and reinstall.
runners/php/vendor/

# Fresh published MCP consumers and evidence; never corpus source.
.mcp-published/
.cleanup-runtimes/

# Candidate SDK evidence is never a normally published reference artifact.
.satellite-candidate/

# Disposable normal published satellite consumers and proof logs.
.satellite-published/

# The PHP reference runner is locked so a corpus verdict cannot move with a
# library release (credential-scope cs-0016 once changed with the Guzzle major).
!/runners/php/composer.lock
