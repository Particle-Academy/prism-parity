{
    "name": "particle-academy/prism-conformance-runner-php",
    "description": "Runs the prism-parity conformance corpus against the PHP reference implementation.",
    "type": "project",
    "license": "MIT",
    "repositories": [
        {
            "type": "path",
            "url": "../../loaders/php",
            "options": {
                "symlink": false
            }
        }
    ],
    "require": {
        "php": "^8.2",
        "particle-academy/prism": ">=0.113 <1.0",
        "particle-academy/prism-conformance": "dev-main|*"
    },
    "minimum-stability": "dev",
    "config": {
        "allow-plugins": {
            "php-http/discovery": true
        }
    },
    "prefer-stable": true
}
