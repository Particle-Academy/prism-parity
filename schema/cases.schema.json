{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/Particle-Academy/prism-parity/schema/cases.schema.json",
  "title": "Conformance cases",
  "$defs": {
    "case": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "title",
        "since",
        "notes",
        "expect"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z]{3}-[0-9]{4}$",
          "description": "Stable forever. NEVER renumbered — ids appear in other repos' skip lists and in probes/probes.json. Ids are unique and sorted ascending, which means a new case goes at the END of the file. File order is not chronology."
        },
        "title": {
          "type": "string",
          "minLength": 1
        },
        "notes": {
          "type": "string",
          "minLength": 1,
          "description": "REQUIRED. What this case exists to catch. A case without a stated purpose gets deleted by someone later who cannot tell it apart from its neighbour."
        },
        "builder": {
          "$ref": "#/$defs/builderScript",
          "description": "For kind=request-payload and kind=error-code."
        },
        "response": {
          "description": "For kind=response-parse: the raw provider response body, exactly as the provider would send it."
        },
        "subject": {
          "$ref": "#/$defs/construct",
          "description": "For kind=roundtrip: the value object under test."
        },
        "expect": {
          "$ref": "#/$defs/expectation"
        },
        "skip": {
          "type": "object",
          "description": "A MAP KEYED BY LANGUAGE. Never a scalar — a loader that reads this as truthy skips the row in every language at once AND makes the empty-reason guard unreachable, because a non-empty object is never blank. Both effects are silent. Every loader pins this from both directions.",
          "minProperties": 1,
          "propertyNames": {
            "enum": [
              "php",
              "ts",
              "py"
            ]
          },
          "additionalProperties": {
            "type": "string",
            "minLength": 1,
            "description": "MANDATORY and non-empty, enforced at LOAD time in every loader. A skip that does not say why becomes permanent silently."
          }
        },
        "since": {
          "type": "string",
          "pattern": "^\\d+\\.\\d+\\.\\d+$",
          "description": "The corpus version this case was added in. Makes the age of a row visible without archaeology, and makes 'this went red after we upgraded' answerable."
        },
        "tolerance": {
          "type": "number",
          "exclusiveMinimum": 0,
          "description": "OPT-IN, PER-ROW, and visible in the row it applies to. Absent means EXACT comparison, which is the default and covers every case in the corpus today. A global epsilon is invisible — nobody reading a fixture can tell whether it asserts a value or a neighbourhood — and an invisible one lets two implementations that computed different values pass as equal, in the repository whose product is catching exactly that. When present, the comparison falls back to structural comparison with this absolute tolerance on numeric leaves. Do not add one without testing the justification first: see docs/decisions/0005-canonical-json.md."
        },
        "left_raw": {
          "type": "string",
          "description": "For kind=container-identity: one side of the pair, as RAW JSON TEXT. Text, not a decoded structure, because a decoded structure authored by running PHP cannot carry an array-versus-object distinction — PHP decodes {} and [] to the identical value. The raw string is the only channel that can hold what the reference language cannot express."
        },
        "right_raw": {
          "type": "string",
          "description": "For kind=container-identity: the other side of the pair, as RAW JSON TEXT."
        }
      }
    },
    "expectation": {
      "type": "object",
      "additionalProperties": false,
      "minProperties": 1,
      "properties": {
        "body_json": {
          "type": "string",
          "description": "Canonical JSON serialization of the provider request body. GENERATED by executing the reference implementation — never hand-authored. See docs/decisions/0005-canonical-json.md."
        },
        "result_json": {
          "type": "string",
          "description": "Canonical JSON serialization of the parsed result's array form. Generated by executing the reference implementation."
        },
        "serialized_json": {
          "type": "string",
          "description": "Canonical JSON serialization of the value object's stored form. Generated by executing the reference implementation."
        },
        "rehydrates": {
          "type": "boolean",
          "description": "When true the runner must also rebuild the value object from serialized_json and re-serialize it to the identical string."
        },
        "error_code": {
          "type": "string",
          "pattern": "^[a-z0-9]+(_[a-z0-9]+)*$",
          "description": "A CODE, never a message. Error prose is worded idiomatically per language; pinning it holds every implementation to a translation and goes red on a wording improvement that changed nothing. The human sentence is explicitly outside the contract."
        },
        "equal_after_parse": {
          "type": "boolean",
          "description": "For kind=container-identity: whether the implementation's own JSON parser considers the two raw strings equal. A row of this kind has NO decoded input to fall back on, so it can only be answered by reading the raw strings — which is what proves the channel is wired to something rather than merely present."
        }
      }
    },
    "builderScript": {
      "type": "array",
      "minItems": 1,
      "description": "An ordered list of calls against the pending-request builder. Method names are the canonical (PHP) spelling; each language's runner maps them to its own idiom — with_prompt in Python, withPrompt in TypeScript. The contract is the call sequence, not the spelling.",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "call"
        ],
        "properties": {
          "call": {
            "type": "string",
            "minLength": 1
          },
          "args": {
            "type": "array"
          }
        }
      }
    },
    "construct": {
      "type": "object",
      "required": [
        "$"
      ],
      "description": "A tagged value-object constructor. '$' names the class; the remaining keys are constructor arguments by canonical name. Nested constructs are resolved depth-first.",
      "properties": {
        "$": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "goldenDocument": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "suite",
        "cases"
      ],
      "properties": {
        "suite": {
          "type": "string",
          "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$",
          "not": {
            "const": "media-fetch-guard"
          }
        },
        "cases": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/case"
          }
        }
      }
    },
    "mediaFetchGuardCase": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "title",
        "since",
        "notes",
        "url",
        "resolves",
        "refusal",
        "agrees"
      ],
      "properties": {
        "id": {},
        "title": {},
        "since": {},
        "notes": {},
        "skip": {},
        "url": {
          "type": "string",
          "minLength": 1
        },
        "resolves": {
          "type": "object",
          "additionalProperties": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        },
        "guarded": {
          "type": "boolean",
          "description": "Absent or true uses the guarded fetch; false exercises an existing unguarded path."
        },
        "redirects_to": {
          "type": "string",
          "minLength": 1,
          "description": "The Location returned by the fake HTTP response; normally the destination serves content."
        },
        "redirects_always": {
          "type": "boolean",
          "description": "When true, every fake response redirects to redirects_to, including requests already at that destination."
        },
        "refusal": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "php",
            "ts",
            "py"
          ],
          "properties": {
            "php": {
              "type": [
                "string",
                "null"
              ],
              "enum": [
                null,
                "scheme_not_allowed",
                "private_address_refused",
                "host_did_not_resolve",
                "redirect_refused",
                "too_many_redirects"
              ]
            },
            "ts": {
              "type": [
                "string",
                "null"
              ],
              "enum": [
                null,
                "scheme_not_allowed",
                "private_address_refused",
                "host_did_not_resolve",
                "redirect_refused",
                "too_many_redirects"
              ]
            },
            "py": {
              "type": [
                "string",
                "null"
              ],
              "enum": [
                null,
                "scheme_not_allowed",
                "private_address_refused",
                "host_did_not_resolve",
                "redirect_refused",
                "too_many_redirects"
              ]
            }
          }
        },
        "agrees": {}
      },
      "allOf": [
        {
          "$ref": "#/$defs/securityCase"
        },
        {
          "if": {
            "required": [
              "redirects_always"
            ],
            "properties": {
              "redirects_always": {
                "const": true
              }
            }
          },
          "then": {
            "required": [
              "redirects_to"
            ],
            "properties": {
              "guarded": {
                "const": true
              }
            }
          }
        }
      ]
    },
    "mediaFetchGuardDocument": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "suite",
        "cases"
      ],
      "properties": {
        "suite": {
          "const": "media-fetch-guard"
        },
        "schema_version": {
          "const": 1
        },
        "corpus_version": {
          "type": "string",
          "pattern": "^\\d+\\.\\d+\\.\\d+$"
        },
        "generated_by": {
          "type": "string",
          "minLength": 1
        },
        "cases": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/mediaFetchGuardCase"
          }
        }
      }
    },
    "securityCase": {
      "type": "object",
      "required": [
        "id",
        "since",
        "notes"
      ],
      "description": "Shared security-corpus spine. Concrete suite definitions close the shape and require their subject fields. The legacy byte-path corpus has no title or recorded language agreement.",
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z]{3}-[0-9]{4}$",
          "description": "Stable forever. NEVER renumbered — ids appear in other repos' skip lists and in probes/probes.json. Ids are unique and sorted ascending, which means a new case goes at the END of the file. File order is not chronology."
        },
        "title": {
          "type": "string",
          "minLength": 1
        },
        "since": {
          "type": "string",
          "pattern": "^\\d+\\.\\d+\\.\\d+$",
          "description": "The corpus version this case was added in. Makes the age of a row visible without archaeology, and makes 'this went red after we upgraded' answerable."
        },
        "notes": {
          "type": "string",
          "minLength": 1,
          "description": "REQUIRED. What this case exists to catch. A case without a stated purpose gets deleted by someone later who cannot tell it apart from its neighbour."
        },
        "skip": {
          "type": "object",
          "description": "A MAP KEYED BY LANGUAGE. Never a scalar — a loader that reads this as truthy skips the row in every language at once AND makes the empty-reason guard unreachable, because a non-empty object is never blank. Both effects are silent. Every loader pins this from both directions.",
          "minProperties": 1,
          "propertyNames": {
            "enum": [
              "php",
              "ts",
              "py"
            ]
          },
          "additionalProperties": {
            "type": "string",
            "minLength": 1,
            "description": "MANDATORY and non-empty, enforced at LOAD time in every loader. A skip that does not say why becomes permanent silently."
          }
        },
        "agrees": {
          "type": "boolean",
          "description": "Whether the three applicable, recorded outcomes agree; an explicit language skip does not establish agreement."
        }
      }
    },
    "embeddingDecodingOutcome": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "embedding"
          ],
          "properties": {
            "embedding": {
              "type": "array",
              "items": {
                "type": "number"
              }
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "exception"
          ],
          "properties": {
            "exception": {
              "type": "string",
              "minLength": 1
            }
          }
        }
      ]
    },
    "embeddingDecodingCase": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "title",
        "agrees",
        "embedding",
        "expected"
      ],
      "properties": {
        "id": {},
        "title": {},
        "since": {},
        "notes": {},
        "skip": {},
        "agrees": {},
        "embedding": {
          "oneOf": [
            {
              "type": "array",
              "items": {
                "type": "number"
              }
            },
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "description": "Decoder input includes malformed strings and null deliberately; input validity is the subject under test."
        },
        "expected": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "php",
            "ts",
            "py"
          ],
          "properties": {
            "php": {
              "oneOf": [
                {
                  "$ref": "#/$defs/embeddingDecodingOutcome"
                },
                {
                  "type": "null"
                }
              ]
            },
            "ts": {
              "oneOf": [
                {
                  "$ref": "#/$defs/embeddingDecodingOutcome"
                },
                {
                  "type": "null"
                }
              ]
            },
            "py": {
              "oneOf": [
                {
                  "$ref": "#/$defs/embeddingDecodingOutcome"
                },
                {
                  "type": "null"
                }
              ]
            }
          }
        }
      },
      "allOf": [
        {
          "$ref": "#/$defs/securityCase"
        }
      ]
    },
    "embeddingDecodingDocument": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "suite",
        "schema_version",
        "corpus_version",
        "cases"
      ],
      "properties": {
        "suite": {
          "const": "embedding-decoding"
        },
        "schema_version": {
          "const": 1
        },
        "corpus_version": {
          "type": "string",
          "pattern": "^\\d+\\.\\d+\\.\\d+$"
        },
        "generated_by": {
          "type": "string",
          "minLength": 1
        },
        "cases": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/embeddingDecodingCase"
          },
          "minItems": 1
        }
      }
    },
